      "expected": [
        {
          "kind": "HTTPRoute",
          "name": "kagent"
        }
      ]
    },
    {
      "id": "q04",
      "style": "literal",
      "question": "Which container image does the qdrant-mcp server run?",
      "answer": "ghcr.io/adamdubnytskyy/abox/qdrant-mcp:0.4.0",
      "expected": [
        {
          "kind": "MCPServer",
          "name": "qdrant-mcp"
        }
      ]
    },
    {
      "id": "q05",
      "style": "paraphrase",
