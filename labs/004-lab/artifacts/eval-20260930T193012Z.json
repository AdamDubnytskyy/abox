      "expected": [
        {
          "kind": "MCPServer",
          "name": "qdrant-mcp"
        }
      ]
    },
    {
      "id": "q06",
      "style": "literal",
      "question": "Which Qdrant collection does the qdrant-mcp-official server use?",
      "answer": "abox-minilm",
      "expected": [
        {
          "kind": "MCPServer",
          "name": "qdrant-mcp-official"
        }
      ]
    },
    {
      "id": "q07",
      "style": "literal",
      "question": "Which tools does the retrieval agent have?",
      "answer": "qdrant-mcp (vector_store, vector_find), neo4j-mcp (get-schema, read-cypher, write-cypher), agent k8s-agent",
      "expected": [
        {
          "kind": "Agent",
          "name": "retrieval-agent"
        }
      ]
    },
    {
      "id": "q08",
      "style": "paraphrase",
      "question": "What must the agent check before saying something is missing from the data?",
      "answer": "Call get-schema and run at least one read-cypher before reporting absence",
      "expected": [
        {
          "kind": "Agent",
          "name": "retrieval-agent"
        }
      ]
    },
    {
      "id": "q09",
      "style": "paraphrase",
      "question": "What has to be installed before kagent itself?",
      "answer": "HelmRelease kagent-crds (dependsOn)",
      "expected": [
        {
          "kind": "HelmRelease",
          "name": "kagent"
        }
      ]
    },
    {
      "id": "q10",
      "style": "literal",
      "question": "Which ReferenceGrant lets HTTPRoutes reference Services in the kagent namespace?",
